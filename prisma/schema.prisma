// RideKmer data model. See docs/DATA_MODEL.md for the narrative description.
// Conventions:
//  - All monetary columns are Int amounts in XAF (no minor unit). Never Float/Decimal for money.
//  - Timestamps are stored in UTC; business-day logic is computed in Africa/Douala.
//  - Financial facts (LedgerEntry, BookingPriceSnapshot, GeneratedContract) are append-only.
//  - "deletedAt" soft deletion is only used where history must be preserved for people/vehicles.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

