// ─────────────────────────────────────────────────────────────────────────────
// Identity, authentication (Better Auth managed tables) and authorisation
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(cuid())
  name                String
  email               String     @unique
  emailVerified       Boolean    @default(false)
  image               String?
  phoneNumber         String?    @unique
  phoneNumberVerified Boolean?   @default(false)
  twoFactorEnabled    Boolean?   @default(false)
  status              UserStatus @default(ACTIVE)
  suspendedAt         DateTime?
  suspensionReason    String?
  preferredLocale     String     @default("fr")
  timezone            String     @default("Africa/Douala")
  lastLoginAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  sessions   Session[]
  accounts   Account[]
  twofactors TwoFactor[]
  userRoles  UserRole[]

  customerProfile  CustomerProfile?
  ownerProfile     OwnerProfile?
  chauffeurProfile ChauffeurProfile?
  addresses        Address[]

  auditLogs            AuditLog[]                @relation("AuditActor")
  notifications        Notification[]
  notificationSettings NotificationPreference[]
  supportCases         SupportCase[]             @relation("SupportRequester")
  assignedSupportCases SupportCase[]             @relation("SupportAssignee")
  dataRequests         DataRequest[]
  reviewsWritten       Review[]                  @relation("ReviewAuthor")
  trackingAccessLogs   TrackingAccessLog[]
  approvals            Approval[]
  documentReviews      VehicleDocument[]         @relation("VehicleDocumentReviewer")
  verificationReviews  VerificationDocument[]    @relation("VerificationDocumentReviewer")
  caseReviews          VerificationCase[]        @relation("VerificationCaseReviewer")
  documentOverrides    DocumentOverride[]        @relation("DocumentOverrideCreator")
  vehicleReviews       Vehicle[]                 @relation("VehicleReviewer")
  inspectionsPerformed Inspection[]              @relation("Inspector")
  bookingStatusChanges BookingStatusHistory[]    @relation("BookingStatusActor")
  incidentsReported    Incident[]                @relation("IncidentReporter")
  incidentStatusChange IncidentStatusHistory[]   @relation("IncidentStatusActor")
  generatedContracts   GeneratedContract[]       @relation("ContractSignatory")
  bookingsAsCustomer   Booking[]                 @relation("BookingCustomer")
  bookingsAsChauffeur  Booking[]                 @relation("BookingChauffeur")
  reservationHolds     ReservationHold[]
  pricingRulesCreated  PricingRule[]             @relation("PricingRuleCreator")
  payoutsRequested     OwnerPayout[]             @relation("PayoutRequester")
  refundsRequested     Refund[]                  @relation("RefundRequester")
  templateVersions     ContractTemplateVersion[] @relation("TemplateVersionAuthor")
  settingsUpdated      SystemSetting[]           @relation("SettingUpdater")
  recordedPayments     Payment[]                 @relation("PaymentRecorder")
  maintenanceCreated   MaintenanceRecord[]       @relation("MaintenanceCreator")
  expensesApproved     Expense[]                 @relation("ExpenseApprover")
  deviceRegistrations  TrackerDevice[]           @relation("DeviceRegistrar")

  @@index([status])
  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isStaff     Boolean  @default(false)
  requiresMfa Boolean  @default(false)
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  category    String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId     String
  roleId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy String?
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?

  @@id([userId, roleId])
  @@index([roleId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Profiles, KYC and addresses
// ─────────────────────────────────────────────────────────────────────────────

model CustomerProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName              String
  lastName               String
  dateOfBirth            DateTime? @db.Date
  nationality            String?
  // Encrypted with APP_ENCRYPTION_KEY; the hash allows duplicate detection without decryption.
  identityNumberEnc      String?
  identityNumberHash     String?
  drivingLicenceNoEnc    String?
  drivingLicenceNoHash   String?
  drivingLicenceExpiry   DateTime? @db.Date
  drivingLicenceCategory String?
  identityVerifiedAt     DateTime?
  licenceVerifiedAt      DateTime?
  approvedAt             DateTime?
  approvedBy             String?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  verificationCases VerificationCase[]
  reviews           Review[]           @relation("ReviewedCustomer")

  @@index([identityNumberHash])
  @@index([drivingLicenceNoHash])
}

model OwnerProfile {
  id                   String        @id @default(cuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownerType            OwnerType     @default(INDIVIDUAL)
  displayName          String
  firstName            String?
  lastName             String?
  identityNumberEnc    String?
  identityNumberHash   String?
  taxIdentifierEnc     String?
  kycApprovedAt        DateTime?
  kycApprovedBy        String?
  payoutMethod         PayoutMethod?
  payoutMobileNumber   String?
  payoutBankName       String?
  payoutBankAccountEnc String?
  payoutAccountName    String?
  payoutVerifiedAt     DateTime?
  agreementAcceptedAt  DateTime?
  onboardingStep       String        @default("profile")
  onboardingComplete   Boolean       @default(false)
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  company           CompanyProfile?
  vehicles          Vehicle[]
  verificationCases VerificationCase[]
  payouts           OwnerPayout[]
  ledgerEntries     LedgerEntry[]
  expenses          Expense[]
  reviews           Review[]           @relation("ReviewedOwner")

  @@index([ownerType])
  @@index([identityNumberHash])
}

model CompanyProfile {
  id                    String       @id @default(cuid())
  ownerProfileId        String       @unique
  ownerProfile          OwnerProfile @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  legalName             String
  tradeName             String?
  registrationNumberEnc String?
  registrationNumberHsh String?
  taxpayerNumberEnc     String?
  legalForm             String?
  representativeName    String?
  representativeTitle   String?
  contactEmail          String?
  contactPhone          String?
  kybApprovedAt         DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([registrationNumberHsh])
}

model ChauffeurProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenceNumberEnc    String?
  licenceExpiry       DateTime? @db.Date
  licenceVerifiedAt   DateTime?
  yearsOfExperience   Int?
  languages           String[]  @default([])
  cityId              String?
  city                City?     @relation(fields: [cityId], references: [id])
  isActive            Boolean   @default(true)
  dailyFeeXaf         Int?
  agreementAcceptedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  reviews Review[] @relation("ReviewedChauffeur")
}

model Address {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String?
  line1         String
  line2         String?
  neighbourhood String?
  cityId        String?
  city          City?    @relation(fields: [cityId], references: [id])
  cityName      String
  region        String?
  country       String   @default("CM")
  latitude      Float?
  longitude     Float?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model VerificationCase {
  id                String                 @id @default(cuid())
  type              VerificationCaseType
  status            VerificationCaseStatus @default(DRAFT)
  customerProfileId String?
  customerProfile   CustomerProfile?       @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  ownerProfileId    String?
  ownerProfile      OwnerProfile?          @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewerId        String?
  reviewer          User?                  @relation("VerificationCaseReviewer", fields: [reviewerId], references: [id])
  rejectionReason   String?
  expiresAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  documents VerificationDocument[]

  @@index([status, type])
  @@index([customerProfileId])
  @@index([ownerProfileId])
}

model DocumentType {
  id                       String              @id @default(cuid())
  key                      String              @unique
  subjectType              DocumentSubjectType
  nameEn                   String
  nameFr                   String
  descriptionEn            String?
  descriptionFr            String?
  isMandatory              Boolean             @default(false)
  requiresExpiry           Boolean             @default(false)
  requiresNumber           Boolean             @default(false)
  blocksVehicleWhenExpired Boolean             @default(false)
  alertDaysBefore          Int[]               @default([60, 30, 14, 7, 0])
  allowedMimeTypes         String[]            @default(["application/pdf", "image/jpeg", "image/png"])
  maxFileSizeBytes         Int                 @default(10485760)
  sortOrder                Int                 @default(0)
  isActive                 Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  vehicleDocuments      VehicleDocument[]
  verificationDocuments VerificationDocument[]

  @@index([subjectType, isActive])
}

model VerificationDocument {
  id                 String                @id @default(cuid())
  verificationCaseId String
  verificationCase   VerificationCase      @relation(fields: [verificationCaseId], references: [id], onDelete: Cascade)
  documentTypeId     String
  documentType       DocumentType          @relation(fields: [documentTypeId], references: [id])
  status             DocumentStatus        @default(DRAFT)
  documentNumberEnc  String?
  issuer             String?
  issueDate          DateTime?             @db.Date
  expiryDate         DateTime?             @db.Date
  storageKey         String
  fileName           String
  mimeType           String
  fileSizeBytes      Int
  checksumSha256     String
  version            Int                   @default(1)
  previousVersionId  String?               @unique
  previousVersion    VerificationDocument? @relation("VerificationDocumentVersions", fields: [previousVersionId], references: [id])
  nextVersion        VerificationDocument? @relation("VerificationDocumentVersions")
  reviewerId         String?
  reviewer           User?                 @relation("VerificationDocumentReviewer", fields: [reviewerId], references: [id])
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([verificationCaseId, status])
  @@index([expiryDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Geography
// ─────────────────────────────────────────────────────────────────────────────

model City {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameEn    String
  nameFr    String
  region    String?
  country   String   @default("CM")
  latitude  Float?
  longitude Float?
  timezone  String   @default("Africa/Douala")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches       Branch[]
  vehicles       Vehicle[]
  addresses      Address[]
  chauffeurs     ChauffeurProfile[]
  geofences      Geofence[]
  pricingRules   PricingRule[]
  bookingsPickup Booking[]          @relation("BookingPickupCity")
}

model Branch {
  id           String   @id @default(cuid())
  cityId       String
  city         City     @relation(fields: [cityId], references: [id])
  slug         String   @unique
  nameEn       String
  nameFr       String
  addressLine  String
  latitude     Float?
  longitude    Float?
  phone        String?
  email        String?
  openingHours Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles       Vehicle[]
  bookingsPickup Booking[] @relation("BookingPickupBranch")
  bookingsReturn Booking[] @relation("BookingReturnBranch")

  @@index([cityId, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Vehicles
// ─────────────────────────────────────────────────────────────────────────────

model Vehicle {
  id             String         @id @default(cuid())
  ownerProfileId String?
  ownerProfile   OwnerProfile?  @relation(fields: [ownerProfileId], references: [id])
  ownershipModel OwnershipModel
  status         VehicleStatus  @default(DRAFT)
  cityId         String
  city           City           @relation(fields: [cityId], references: [id])
  branchId       String?
  branch         Branch?        @relation(fields: [branchId], references: [id])

  registrationNumber    String          @unique
  vinEnc                String?
  vinHash               String?         @unique
  make                  String
  model                 String
  trim                  String?
  manufacturingYear     Int
  firstRegistrationDate DateTime?       @db.Date
  category              VehicleCategory
  bodyType              BodyType        @default(OTHER)
  colour                String?
  transmission          Transmission
  fuelType              FuelType
  engineCapacityCc      Int?
  seats                 Int
  doors                 Int?
  currentMileageKm      Int             @default(0)
  hasAirConditioning    Boolean         @default(true)
  hasBluetooth          Boolean         @default(false)
  hasUsbCharging        Boolean         @default(false)
  hasReversingCamera    Boolean         @default(false)
  safetyEquipment       String[]        @default([])

  locationLabel     String?
  latitude          Float?
  longitude         Float?
  deliveryAvailable Boolean @default(false)
  deliveryRadiusKm  Int?

  dailyPriceXaf        Int
  weeklyPriceXaf       Int?
  monthlyPriceXaf      Int?
  securityDepositXaf   Int
  dailyKmAllowance     Int?
  extraKmRateXaf       Int?
  chauffeurAvailable   Boolean @default(false)
  chauffeurDailyFeeXaf Int?
  selfDriveAllowed     Boolean @default(true)
  instantBooking       Boolean @default(false)
  minRentalDays        Int     @default(1)
  maxRentalDays        Int?

  descriptionEn       String?
  descriptionFr       String?
  existingDamageNotes String?

  publishedAt        DateTime?
  reviewedAt         DateTime?
  reviewerId         String?
  reviewer           User?                    @relation("VehicleReviewer", fields: [reviewerId], references: [id])
  rejectionReason    String?
  suspensionReason   String?
  documentsValid     Boolean                  @default(false)
  ownerRequestType   VehicleOwnerRequestType?
  ownerRequestReason String?
  ownerRequestedAt   DateTime?
  submittedAt        DateTime?
  onboardingStep     String                   @default("basics")
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?

  managementConfig    VehicleManagementConfig?
  features            VehicleFeature[]
  images              VehicleImage[]
  availabilityBlocks  VehicleAvailability[]
  documents           VehicleDocument[]
  documentOverrides   DocumentOverride[]
  trackerAssignments  VehicleTrackerAssignment[]
  trackingEvents      TrackingEvent[]
  bookings            Booking[]
  reservationHolds    ReservationHold[]
  inspections         Inspection[]
  damages             VehicleDamage[]
  maintenanceSchedule MaintenanceSchedule[]
  maintenanceRecords  MaintenanceRecord[]
  expenses            Expense[]
  incidents           Incident[]
  reviews             Review[]                   @relation("ReviewedVehicle")
  ledgerEntries       LedgerEntry[]
  pricingRules        PricingRule[]

  @@index([status, cityId])
  @@index([ownerProfileId])
  @@index([category, transmission, fuelType])
  @@index([dailyPriceXaf])
  @@index([make, model])
}

model VehicleManagementConfig {
  id                            String   @id @default(cuid())
  vehicleId                     String   @unique
  vehicle                       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  ownerApprovesBookings         Boolean  @default(false)
  ownerHandlesHandover          Boolean  @default(false)
  ownerHandlesInspections       Boolean  @default(false)
  ownerHandlesCustomerContact   Boolean  @default(false)
  ownerHandlesMaintenance       Boolean  @default(false)
  ownerApprovesExpensesAboveXaf Int?
  commissionPercent             Int?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model VehicleFeature {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  key       String
  value     String?

  @@unique([vehicleId, key])
}

model VehicleImage {
  id             String   @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  storageKey     String
  altTextEn      String?
  altTextFr      String?
  width          Int?
  height         Int?
  sortOrder      Int      @default(0)
  isPrimary      Boolean  @default(false)
  isPublic       Boolean  @default(true)
  checksumSha256 String?
  createdAt      DateTime @default(now())

  @@index([vehicleId, sortOrder])
}

model VehicleAvailability {
  id        String                @id @default(cuid())
  vehicleId String
  vehicle   Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      AvailabilityBlockType
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdBy String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([vehicleId, startAt, endAt])
}

model VehicleDocument {
  id                  String           @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentTypeId      String
  documentType        DocumentType     @relation(fields: [documentTypeId], references: [id])
  status              DocumentStatus   @default(DRAFT)
  documentNumberEnc   String?
  issuer              String?
  issueDate           DateTime?        @db.Date
  expiryDate          DateTime?        @db.Date
  storageKey          String
  fileName            String
  mimeType            String
  fileSizeBytes       Int
  checksumSha256      String
  version             Int              @default(1)
  previousVersionId   String?          @unique
  previousVersion     VehicleDocument? @relation("VehicleDocumentVersions", fields: [previousVersionId], references: [id])
  nextVersion         VehicleDocument? @relation("VehicleDocumentVersions")
  reviewerId          String?
  reviewer            User?            @relation("VehicleDocumentReviewer", fields: [reviewerId], references: [id])
  verifiedAt          DateTime?
  rejectionReason     String?
  lastAlertDaysBefore Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([vehicleId, status])
  @@index([expiryDate, status])
}

model DocumentOverride {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("DocumentOverrideCreator", fields: [createdById], references: [id])
  reason      String
  startsAt    DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedBy   String?
  createdAt   DateTime  @default(now())

  @@index([vehicleId, expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Telematics
// ─────────────────────────────────────────────────────────────────────────────

model TrackerDevice {
  id                 String              @id @default(cuid())
  type               TrackerDeviceType   @default(COMMERCIAL_GPS)
  provider           String
  // Provider-side identifier; never rendered on public pages.
  externalDeviceId   String
  serialNumberEnc    String?
  model              String?
  status             TrackerDeviceStatus @default(REGISTERED)
  simNumberEnc       String?
  installedAt        DateTime?
  installedBy        String?
  installationNotes  String?
  consentDocumentKey String?
  lastSeenAt         DateTime?
  batteryPercent     Int?
  powerStatus        String?
  tamperStatus       String?
  registeredById     String?
  registeredBy       User?               @relation("DeviceRegistrar", fields: [registeredById], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  assignments VehicleTrackerAssignment[]
  events      TrackingEvent[]

  @@unique([provider, externalDeviceId])
  @@index([status])
}

model VehicleTrackerAssignment {
  id             String        @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  deviceId       String
  device         TrackerDevice @relation(fields: [deviceId], references: [id])
  assignedAt     DateTime      @default(now())
  unassignedAt   DateTime?
  ownerConsentAt DateTime?
  consentNotes   String?
  assignedBy     String?

  @@index([vehicleId, unassignedAt])
  @@index([deviceId, unassignedAt])
}

model TrackingEvent {
  id              String            @id @default(cuid())
  deviceId        String
  device          TrackerDevice     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicle         Vehicle?          @relation(fields: [vehicleId], references: [id])
  type            TrackingEventType
  recordedAt      DateTime
  receivedAt      DateTime          @default(now())
  latitude        Float?
  longitude       Float?
  speedKmh        Float?
  heading         Float?
  ignitionOn      Boolean?
  powerStatus     String?
  tamper          Boolean?
  rawPayload      Json?
  providerEventId String?

  @@unique([deviceId, providerEventId])
  @@index([vehicleId, recordedAt])
  @@index([deviceId, recordedAt])
  @@index([recordedAt])
}

model TrackingAccessLog {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  vehicleId  String
  accessType TrackingAccessType
  rangeStart DateTime?
  rangeEnd   DateTime?
  reason     String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime           @default(now())

  @@index([vehicleId, createdAt])
  @@index([userId, createdAt])
}

model Geofence {
  id          String       @id @default(cuid())
  name        String
  type        GeofenceType @default(CUSTOM)
  cityId      String?
  city        City?        @relation(fields: [cityId], references: [id])
  // GeoJSON polygon or {center, radiusMeters}
  geometry    Json
  isActive    Boolean      @default(true)
  alertOnExit Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Pricing, bookings and holds
// ─────────────────────────────────────────────────────────────────────────────

model PricingRule {
  id          String          @id @default(cuid())
  type        PricingRuleType
  name        String
  cityId      String?
  city        City?           @relation(fields: [cityId], references: [id])
  vehicleId   String?
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id])
  startsOn    DateTime?       @db.Date
  endsOn      DateTime?       @db.Date
  // Basis points (10000 = 100%) for multipliers/percentages; XAF for fixed amounts.
  percentBps  Int?
  amountXaf   Int?
  minDays     Int?
  priority    Int             @default(0)
  isActive    Boolean         @default(true)
  createdById String?
  createdBy   User?           @relation("PricingRuleCreator", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([type, isActive])
  @@index([cityId])
  @@index([vehicleId])
}

model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique
  descriptionEn  String?
  descriptionFr  String?
  discountType   PromoDiscountType
  percentBps     Int?
  amountXaf      Int?
  maxDiscountXaf Int?
  minBookingXaf  Int?
  startsAt       DateTime?
  endsAt         DateTime?
  maxRedemptions Int?
  redemptions    Int               @default(0)
  perUserLimit   Int               @default(1)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  bookings Booking[]
}

model ReservationHold {
  id         String                @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?                 @relation(fields: [userId], references: [id])
  sessionKey String?
  startAt    DateTime
  endAt      DateTime
  status     ReservationHoldStatus @default(ACTIVE)
  expiresAt  DateTime
  bookingId  String?               @unique
  booking    Booking?              @relation(fields: [bookingId], references: [id])
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([vehicleId, status, expiresAt])
  @@index([expiresAt, status])
}

model Booking {
  id                      String        @id @default(cuid())
  reference               String        @unique
  customerId              String
  customer                User          @relation("BookingCustomer", fields: [customerId], references: [id])
  vehicleId               String
  vehicle                 Vehicle       @relation(fields: [vehicleId], references: [id])
  chauffeurId             String?
  chauffeur               User?         @relation("BookingChauffeur", fields: [chauffeurId], references: [id])
  type                    BookingType   @default(SELF_DRIVE)
  status                  BookingStatus @default(DRAFT)
  startAt                 DateTime
  endAt                   DateTime
  rentalDays              Int
  pickupMode              HandoverMode  @default(BRANCH_PICKUP)
  returnMode              HandoverMode  @default(BRANCH_PICKUP)
  pickupCityId            String?
  pickupCity              City?         @relation("BookingPickupCity", fields: [pickupCityId], references: [id])
  pickupBranchId          String?
  pickupBranch            Branch?       @relation("BookingPickupBranch", fields: [pickupBranchId], references: [id])
  returnBranchId          String?
  returnBranch            Branch?       @relation("BookingReturnBranch", fields: [returnBranchId], references: [id])
  pickupAddress           String?
  pickupLatitude          Float?
  pickupLongitude         Float?
  returnAddress           String?
  promoCodeId             String?
  promoCode               PromoCode?    @relation(fields: [promoCodeId], references: [id])
  customerNotes           String?
  internalNotes           String?
  cancellationReason      String?
  cancelledAt             DateTime?
  confirmedAt             DateTime?
  pickedUpAt              DateTime?
  returnedAt              DateTime?
  completedAt             DateTime?
  paymentDueAt            DateTime?
  extensionRequestedEndAt DateTime?
  cancellationFeeXaf      Int?
  cancelledById           String?
  additionalDrivers       Int           @default(0)
  promoCodeValue          String?
  currencyCode            String        @default("XAF")
  timezone                String        @default("Africa/Douala")
  version                 Int           @default(1)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  statusHistory  BookingStatusHistory[]
  addOns         BookingAddOn[]
  priceSnapshots BookingPriceSnapshot[]
  hold           ReservationHold?
  payments       Payment[]
  refunds        Refund[]
  ledgerEntries  LedgerEntry[]
  contracts      GeneratedContract[]
  inspections    Inspection[]
  incidents      Incident[]
  reviews        Review[]
  supportCases   SupportCase[]
  damages        VehicleDamage[]

  @@index([vehicleId, startAt, endAt])
  @@index([customerId, status])
  @@index([status, startAt])
  @@index([createdAt])
}

model BookingStatusHistory {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorId    String?
  actor      User?          @relation("BookingStatusActor", fields: [actorId], references: [id])
  actorType  ActorType      @default(USER)
  reason     String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([bookingId, createdAt])
}

model BookingAddOn {
  id            String  @id @default(cuid())
  bookingId     String
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  key           String
  labelEn       String
  labelFr       String
  quantity      Int     @default(1)
  unitPriceXaf  Int
  totalPriceXaf Int

  @@index([bookingId])
}

// Immutable: a new snapshot row is created whenever the price is recalculated.
model BookingPriceSnapshot {
  id                  String   @id @default(cuid())
  bookingId           String
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sequence            Int
  rentalDays          Int
  dailyRateXaf        Int
  baseRentalXaf       Int
  deliveryFeeXaf      Int      @default(0)
  returnPickupFeeXaf  Int      @default(0)
  chauffeurFeeXaf     Int      @default(0)
  additionalDriverXaf Int      @default(0)
  addOnsXaf           Int      @default(0)
  serviceFeeXaf       Int      @default(0)
  discountXaf         Int      @default(0)
  taxXaf              Int      @default(0)
  totalRentalXaf      Int
  securityDepositXaf  Int
  kmAllowance         Int?
  extraKmRateXaf      Int?
  commissionBps       Int
  commissionXaf       Int
  ownerShareXaf       Int
  breakdown           Json
  pricingVersion      String
  createdAt           DateTime @default(now())

  @@unique([bookingId, sequence])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                  String         @id @default(cuid())
  bookingId           String?
  booking             Booking?       @relation(fields: [bookingId], references: [id])
  purpose             PaymentPurpose
  method              PaymentMethod
  provider            String
  status              PaymentStatus  @default(CREATED)
  amountXaf           Int
  /// Part of amountXaf that is the refundable security deposit (Mobile Money deposits are real debits).
  depositXaf          Int            @default(0)
  refundedXaf         Int            @default(0)
  currencyCode        String         @default("XAF")
  idempotencyKey      String         @unique
  providerReference   String?
  providerEnvironment String?
  customerInstruction String?
  redirectUrl         String?
  lastCheckedAt       DateTime?
  payerPhoneMasked    String?
  description         String?
  failureCode         String?
  failureMessage      String?
  confirmedAt         DateTime?
  expiresAt           DateTime?
  reconciledAt        DateTime?
  recordedById        String?
  recordedBy          User?          @relation("PaymentRecorder", fields: [recordedById], references: [id])
  metadata            Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  attempts      PaymentAttempt[]
  webhookEvents PaymentWebhookEvent[]
  refunds       Refund[]
  ledgerEntries LedgerEntry[]

  @@index([bookingId, purpose])
  @@index([status, createdAt])
  @@index([provider, providerReference])
}

model PaymentAttempt {
  id                String        @id @default(cuid())
  paymentId         String
  payment           Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  status            PaymentStatus
  providerRequestId String?
  providerResponse  Json?
  errorCode         String?
  errorMessage      String?
  startedAt         DateTime      @default(now())
  completedAt       DateTime?

  @@unique([paymentId, attemptNumber])
}

model PaymentWebhookEvent {
  id              String             @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  signatureValid  Boolean
  status          WebhookEventStatus @default(RECEIVED)
  paymentId       String?
  payment         Payment?           @relation(fields: [paymentId], references: [id])
  payloadHash     String
  payload         Json
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  error           String?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
}

model Refund {
  id                   String       @id @default(cuid())
  paymentId            String
  payment              Payment      @relation(fields: [paymentId], references: [id])
  bookingId            String?
  booking              Booking?     @relation(fields: [bookingId], references: [id])
  status               RefundStatus @default(REQUESTED)
  amountXaf            Int
  reason               String
  idempotencyKey       String       @unique
  providerReference    String?
  requestedById        String?
  requestedBy          User?        @relation("RefundRequester", fields: [requestedById], references: [id])
  requiresDualApproval Boolean      @default(false)
  approvedById         String?
  approvedAt           DateTime?
  processedAt          DateTime?
  failureMessage       String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([status])
  @@index([paymentId])
}

model Approval {
  id          String              @id @default(cuid())
  subjectType ApprovalSubjectType
  subjectId   String
  approverId  String
  approver    User                @relation(fields: [approverId], references: [id])
  decision    ApprovalDecision
  comment     String?
  createdAt   DateTime            @default(now())

  @@unique([subjectType, subjectId, approverId])
  @@index([subjectType, subjectId])
}

model IdempotencyKey {
  key          String   @id
  scope        String
  requestHash  String
  responseBody Json?
  statusCode   Int?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ledger and payouts (append-only)
// ─────────────────────────────────────────────────────────────────────────────

model LedgerAccount {
  id             String            @id @default(cuid())
  key            String            @unique
  kind           LedgerAccountKind
  name           String
  ownerProfileId String?
  currencyCode   String            @default("XAF")
  createdAt      DateTime          @default(now())

  debitEntries  LedgerEntry[] @relation("LedgerDebit")
  creditEntries LedgerEntry[] @relation("LedgerCredit")
}

model LedgerEntry {
  id              String          @id @default(cuid())
  type            LedgerEntryType
  amountXaf       Int
  debitAccountId  String
  debitAccount    LedgerAccount   @relation("LedgerDebit", fields: [debitAccountId], references: [id])
  creditAccountId String
  creditAccount   LedgerAccount   @relation("LedgerCredit", fields: [creditAccountId], references: [id])
  bookingId       String?
  booking         Booking?        @relation(fields: [bookingId], references: [id])
  paymentId       String?
  payment         Payment?        @relation(fields: [paymentId], references: [id])
  refundId        String?
  refund          Refund?         @relation(fields: [refundId], references: [id])
  payoutId        String?
  payout          OwnerPayout?    @relation(fields: [payoutId], references: [id])
  ownerProfileId  String?
  ownerProfile    OwnerProfile?   @relation(fields: [ownerProfileId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?        @relation(fields: [vehicleId], references: [id])
  expenseId       String?
  expense         Expense?        @relation(fields: [expenseId], references: [id])
  reversesEntryId String?         @unique
  reversesEntry   LedgerEntry?    @relation("LedgerReversal", fields: [reversesEntryId], references: [id])
  reversedBy      LedgerEntry?    @relation("LedgerReversal")
  description     String
  effectiveAt     DateTime        @default(now())
  idempotencyKey  String          @unique
  metadata        Json?
  createdAt       DateTime        @default(now())

  @@index([ownerProfileId, effectiveAt])
  @@index([bookingId])
  @@index([type, effectiveAt])
}

model OwnerPayout {
  id                   String       @id @default(cuid())
  ownerProfileId       String
  ownerProfile         OwnerProfile @relation(fields: [ownerProfileId], references: [id])
  status               PayoutStatus @default(DRAFT)
  method               PayoutMethod
  amountXaf            Int
  periodStart          DateTime     @db.Date
  periodEnd            DateTime     @db.Date
  destinationMasked    String?
  idempotencyKey       String       @unique
  providerReference    String?
  requiresDualApproval Boolean      @default(false)
  requestedById        String?
  requestedBy          User?        @relation("PayoutRequester", fields: [requestedById], references: [id])
  statementKey         String?
  failureMessage       String?
  paidAt               DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([ownerProfileId, status])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Contracts
// ─────────────────────────────────────────────────────────────────────────────

model ContractTemplate {
  id        String       @id @default(cuid())
  key       String       @unique
  type      ContractType
  nameEn    String
  nameFr    String
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  versions ContractTemplateVersion[]
}

model ContractTemplateVersion {
  id             String           @id @default(cuid())
  templateId     String
  template       ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version        Int
  locale         String
  bodyMarkdown   String
  variables      Json
  checksumSha256 String
  publishedAt    DateTime?
  authorId       String?
  author         User?            @relation("TemplateVersionAuthor", fields: [authorId], references: [id])
  createdAt      DateTime         @default(now())

  generated GeneratedContract[]

  @@unique([templateId, version, locale])
}

// Immutable once generated.
model GeneratedContract {
  id                 String                  @id @default(cuid())
  templateVersionId  String
  templateVersion    ContractTemplateVersion @relation(fields: [templateVersionId], references: [id])
  type               ContractType
  status             ContractStatus          @default(GENERATED)
  bookingId          String?
  booking            Booking?                @relation(fields: [bookingId], references: [id])
  subjectType        String
  subjectId          String
  signatoryId        String?
  signatory          User?                   @relation("ContractSignatory", fields: [signatoryId], references: [id])
  locale             String
  renderedMarkdown   String
  renderedStorageKey String?
  checksumSha256     String
  variablesSnapshot  Json
  acceptedAt         DateTime?
  declinedAt         DateTime?
  voidedAt           DateTime?
  createdAt          DateTime                @default(now())

  signatures SignatureEvidence[]

  @@index([bookingId])
  @@index([subjectType, subjectId])
}

model SignatureEvidence {
  id               String            @id @default(cuid())
  contractId       String
  contract         GeneratedContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signatoryId      String
  signatoryName    String
  method           SignatureMethod   @default(CLICK_TO_ACCEPT)
  acceptedAt       DateTime          @default(now())
  ipAddress        String?
  userAgent        String?
  otpVerifiedAt    DateTime?
  contractChecksum String
  evidence         Json?

  @@index([contractId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Inspections and damage
// ─────────────────────────────────────────────────────────────────────────────

model Inspection {
  id                     String           @id @default(cuid())
  vehicleId              String
  vehicle                Vehicle          @relation(fields: [vehicleId], references: [id])
  bookingId              String?
  booking                Booking?         @relation(fields: [bookingId], references: [id])
  type                   InspectionType
  status                 InspectionStatus @default(DRAFT)
  inspectorId            String?
  inspector              User?            @relation("Inspector", fields: [inspectorId], references: [id])
  performedAt            DateTime         @default(now())
  mileageKm              Int?
  fuelLevelPercent       Int?
  exteriorCondition      Json?
  interiorCondition      Json?
  tyresCondition         Json?
  windscreenCondition    String?
  lightsCondition        Json?
  accessories            Json?
  documentsPresent       Json?
  notes                  String?
  latitude               Float?
  longitude              Float?
  locationConsent        Boolean          @default(false)
  customerAcknowledgedAt DateTime?
  customerSignatureKey   String?
  staffAcknowledgedAt    DateTime?
  clientDraftId          String?          @unique
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  photos  InspectionPhoto[]
  damages VehicleDamage[]

  @@index([vehicleId, type])
  @@index([bookingId])
}

model InspectionPhoto {
  id             String     @id @default(cuid())
  inspectionId   String
  inspection     Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  storageKey     String
  checksumSha256 String
  area           String?
  caption        String?
  takenAt        DateTime
  latitude       Float?
  longitude      Float?
  createdAt      DateTime   @default(now())

  @@index([inspectionId])
}

model VehicleDamage {
  id            String         @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  inspectionId  String?
  inspection    Inspection?    @relation(fields: [inspectionId], references: [id])
  bookingId     String?
  booking       Booking?       @relation(fields: [bookingId], references: [id])
  incidentId    String?
  incident      Incident?      @relation(fields: [incidentId], references: [id])
  // Normalised coordinates (0..1) on RideKmer's original vehicle outline diagram.
  diagramView   String
  markerX       Float
  markerY       Float
  area          String
  damageType    String
  severity      DamageSeverity @default(MINOR)
  description   String?
  isPreExisting Boolean        @default(false)
  repairedAt    DateTime?
  estimateXaf   Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([vehicleId, repairedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Maintenance and expenses
// ─────────────────────────────────────────────────────────────────────────────

model MaintenanceSchedule {
  id                 String          @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type               MaintenanceType
  intervalDays       Int?
  intervalKm         Int?
  nextDueDate        DateTime?       @db.Date
  nextDueKm          Int?
  reminderDaysBefore Int             @default(14)
  reminderKmBefore   Int             @default(500)
  lastDoneAt         DateTime?
  lastDoneKm         Int?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([vehicleId, nextDueDate])
}

model MaintenanceRecord {
  id              String            @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type            MaintenanceType
  status          MaintenanceStatus @default(SCHEDULED)
  title           String
  description     String?
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  mileageKm       Int?
  providerName    String?
  providerContact String?
  quoteXaf        Int?
  quoteStorageKey String?
  finalCostXaf    Int?
  downtimeStart   DateTime?
  downtimeEnd     DateTime?
  ownerApprovedAt DateTime?
  ownerApprovedBy String?
  createdById     String?
  createdBy       User?             @relation("MaintenanceCreator", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  expenses Expense[]

  @@index([vehicleId, status])
  @@index([scheduledFor])
}

model Expense {
  id                  String             @id @default(cuid())
  vehicleId           String
  vehicle             Vehicle            @relation(fields: [vehicleId], references: [id])
  ownerProfileId      String?
  ownerProfile        OwnerProfile?      @relation(fields: [ownerProfileId], references: [id])
  maintenanceRecordId String?
  maintenanceRecord   MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id])
  status              ExpenseStatus      @default(PENDING)
  allocation          ExpenseAllocation  @default(OWNER)
  category            String
  description         String
  amountXaf           Int
  ownerShareXaf       Int                @default(0)
  ridekmerShareXaf    Int                @default(0)
  customerShareXaf    Int                @default(0)
  receiptStorageKey   String?
  incurredOn          DateTime           @db.Date
  approvedById        String?
  approvedBy          User?              @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([vehicleId, incurredOn])
  @@index([ownerProfileId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Incidents
// ─────────────────────────────────────────────────────────────────────────────

model Incident {
  id                  String         @id @default(cuid())
  reference           String         @unique
  vehicleId           String
  vehicle             Vehicle        @relation(fields: [vehicleId], references: [id])
  bookingId           String?
  booking             Booking?       @relation(fields: [bookingId], references: [id])
  type                IncidentType
  status              IncidentStatus @default(REPORTED)
  reportedById        String?
  reportedBy          User?          @relation("IncidentReporter", fields: [reportedById], references: [id])
  occurredAt          DateTime
  locationDescription String?
  latitude            Float?
  longitude           Float?
  description         String
  policeReportNumber  String?
  policeReportKey     String?
  witnessInfo         Json?
  photoKeys           String[]       @default([])
  repairEstimateXaf   Int?
  customerLiableXaf   Int?
  depositDeductionXaf Int?
  responsibilityNotes String?
  resolutionNotes     String?
  resolvedAt          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  statusHistory IncidentStatusHistory[]
  claims        InsuranceClaim[]
  damages       VehicleDamage[]

  @@index([vehicleId, status])
  @@index([bookingId])
}

model IncidentStatusHistory {
  id         String          @id @default(cuid())
  incidentId String
  incident   Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromStatus IncidentStatus?
  toStatus   IncidentStatus
  actorId    String?
  actor      User?           @relation("IncidentStatusActor", fields: [actorId], references: [id])
  note       String?
  createdAt  DateTime        @default(now())

  @@index([incidentId, createdAt])
}

model InsuranceClaim {
  id             String               @id @default(cuid())
  incidentId     String
  incident       Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  insurerName    String
  claimReference String?
  status         InsuranceClaimStatus @default(DRAFT)
  claimedXaf     Int?
  settledXaf     Int?
  submittedAt    DateTime?
  settledAt      DateTime?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([incidentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews, notifications, support, settings, audit
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id                 String            @id @default(cuid())
  bookingId          String
  booking            Booking           @relation(fields: [bookingId], references: [id])
  authorId           String
  author             User              @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectType        ReviewSubjectType
  vehicleId          String?
  vehicle            Vehicle?          @relation("ReviewedVehicle", fields: [vehicleId], references: [id])
  customerProfileId  String?
  customerProfile    CustomerProfile?  @relation("ReviewedCustomer", fields: [customerProfileId], references: [id])
  ownerProfileId     String?
  ownerProfile       OwnerProfile?     @relation("ReviewedOwner", fields: [ownerProfileId], references: [id])
  chauffeurProfileId String?
  chauffeurProfile   ChauffeurProfile? @relation("ReviewedChauffeur", fields: [chauffeurProfileId], references: [id])
  rating             Int
  comment            String?
  isPublished        Boolean           @default(false)
  moderatedBy        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([bookingId, authorId, subjectType])
  @@index([vehicleId, isPublished])
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  key       String
  channel   NotificationChannel
  locale    String
  subject   String?
  body      String
  variables String[]            @default([])
  isActive  Boolean             @default(true)
  version   Int                 @default(1)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([key, channel, locale])
}

model Notification {
  id                String              @id @default(cuid())
  userId            String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  templateKey       String
  locale            String
  recipient         String?
  subject           String?
  body              String
  status            NotificationStatus  @default(QUEUED)
  provider          String?
  providerMessageId String?
  error             String?
  entityType        String?
  entityId          String?
  dedupeKey         String?             @unique
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, channel, readAt])
  @@index([status, createdAt])
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  category  String
  enabled   Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel, category])
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model SupportCase {
  id           String            @id @default(cuid())
  reference    String            @unique
  requesterId  String?
  requester    User?             @relation("SupportRequester", fields: [requesterId], references: [id])
  assigneeId   String?
  assignee     User?             @relation("SupportAssignee", fields: [assigneeId], references: [id])
  bookingId    String?
  booking      Booking?          @relation(fields: [bookingId], references: [id])
  status       SupportCaseStatus @default(OPEN)
  category     String
  subject      String
  description  String
  contactEmail String?
  contactPhone String?
  locale       String            @default("fr")
  resolvedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([requesterId])
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        DataRequestType
  status      DataRequestStatus @default(REQUESTED)
  reason      String?
  exportKey   String?
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

model SystemSetting {
  key           String           @id
  valueType     SettingValueType @default(STRING)
  value         String
  descriptionEn String?
  descriptionFr String?
  category      String           @default("general")
  isPublic      Boolean          @default(false)
  updatedById   String?
  updatedBy     User?            @relation("SettingUpdater", fields: [updatedById], references: [id])
  updatedAt     DateTime         @updatedAt
  createdAt     DateTime         @default(now())
}

model AuditLog {
  id         String    @id @default(cuid())
  actorId    String?
  actor      User?     @relation("AuditActor", fields: [actorId], references: [id])
  actorType  ActorType @default(USER)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
