# ─────────────────────────────────────────────────────────────────────────────
# RideKmer environment variables — EXAMPLE FILE ONLY.
# Copy to `.env` for local development. Never commit `.env` or real values.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser: never put secrets there.
# Production and preview values live in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development                       # development | preview | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=RideKmer
NEXT_PUBLIC_DEFAULT_LOCALE=fr
APP_TIMEZONE=Africa/Douala
APP_CURRENCY=XAF
LOG_LEVEL=info                            # fatal | error | warn | info | debug

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Runtime (pooled) connection used by the application on Vercel.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ridekmer_dev?schema=public
# Direct (non-pooled) connection used ONLY by Prisma Migrate. Required by Neon/Supabase pools.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ridekmer_dev?schema=public
# Separate database for integration tests (never point this at production).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ridekmer_test?schema=public

# ── Authentication ───────────────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated additional trusted origins (preview URLs etc.)
AUTH_TRUSTED_ORIGINS=
# Require TOTP MFA for staff roles (true in production)
AUTH_REQUIRE_STAFF_MFA=true

# ── Field-level encryption (sensitive columns, e.g. document numbers) ────────
# 32 bytes base64, e.g. `openssl rand -base64 32`
APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
APP_ENCRYPTION_KEY_ID=v1

# ── Redis / rate limiting (Upstash, Vercel-compatible) ───────────────────────
# Leave empty in development to use the in-memory fallback (single process only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Private file storage ─────────────────────────────────────────────────────
STORAGE_PROVIDER=local                    # local (dev only) | vercel-blob | s3
BLOB_READ_WRITE_TOKEN=                    # Vercel Blob
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_MAX_FILE_SIZE_BYTES=10485760
MALWARE_SCAN_PROVIDER=none                # none | clamav-http | custom

# ── Email provider ───────────────────────────────────────────────────────────
EMAIL_PROVIDER=log                        # log (dev) | resend | smtp
EMAIL_FROM="RideKmer <no-reply@example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── SMS provider (OTP, reminders) ────────────────────────────────────────────
SMS_PROVIDER=log                          # log (dev) | generic-http
SMS_SENDER_ID=RideKmer
SMS_API_URL=
SMS_API_KEY=

# ── WhatsApp Business provider ───────────────────────────────────────────────
WHATSAPP_PROVIDER=log                     # log (dev) | meta-cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Web push (PWA notifications) ─────────────────────────────────────────────
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@example.com

# ── Payments: MTN Mobile Money ───────────────────────────────────────────────
# Real endpoints and credentials come from the MTN MoMo developer portal / merchant onboarding.
# Production activation is PENDING merchant credentials and provider approval.
MTN_MOMO_ENVIRONMENT=mock                 # mock | sandbox | production
MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=

# ── Payments: Orange Money ───────────────────────────────────────────────────
ORANGE_MONEY_ENVIRONMENT=mock             # mock | sandbox | production
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

# ── Payments: card provider ──────────────────────────────────────────────────
CARD_PAYMENT_PROVIDER=mock                # mock | <provider id once selected>
CARD_PAYMENT_PUBLIC_KEY=
CARD_PAYMENT_SECRET_KEY=
CARD_PAYMENT_WEBHOOK_SECRET=

# ── Payments: general ────────────────────────────────────────────────────────
PAYMENT_WEBHOOK_REPLAY_WINDOW_SECONDS=300
PAYMENT_DUAL_APPROVAL_THRESHOLD_XAF=200000

# ── GPS / telematics provider ────────────────────────────────────────────────
GPS_PROVIDER=mock                         # mock | generic-rest
GPS_PROVIDER_BASE_URL=
GPS_PROVIDER_API_KEY=
GPS_WEBHOOK_SECRET=
GPS_LOCATION_RETENTION_DAYS=90

# ── Monitoring ───────────────────────────────────────────────────────────────
MONITORING_PROVIDER=none                  # none | sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Scheduled jobs (Vercel Cron) ─────────────────────────────────────────────
# Vercel sends `Authorization: Bearer $CRON_SECRET` to cron route handlers.
CRON_SECRET=replace-with-a-long-random-secret

# ── Demo data ────────────────────────────────────────────────────────────────
# Demo users are only ever seeded when NODE_ENV != production AND this is "true".
ALLOW_DEMO_SEED=true
